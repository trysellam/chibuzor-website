<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Case Study — From Guesswork to a Priced, Working Business | Chibuzor Mordi</title>
<meta name="description" content="How a LinkedIn brand strategist replaced guesswork pricing with a system, and grew her monthly income by 40 percent.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,500;1,600&family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root {
    --charcoal: #242323;
    --charcoal-light: #2e2d2d;
    --charcoal-mid: #3a3939;
    --gold: #C9A551;
    --gold-light: #e0bf7a;
    --gold-dim: #8a6f33;
    --warm-white: #F8F5EF;
    --warm-white-dim: #c8c4bc;
    --warm-white-muted: #837f75;
  }

  * { box-sizing: border-box; margin: 0; padding: 0; }
  html { scroll-behavior: smooth; }

  body {
    font-family: 'DM Sans', sans-serif;
    background: var(--charcoal);
    color: var(--warm-white);
    line-height: 1.65;
    -webkit-font-smoothing: antialiased;
  }

  h1, h2, h3 {
    font-family: 'Playfair Display', serif;
    color: var(--warm-white);
    line-height: 1.18;
    font-weight: 600;
  }

  em { font-style: italic; color: var(--gold); }

  .wrap {
    max-width: 760px;
    margin: 0 auto;
    padding: 0 28px;
  }

  a { color: inherit; }

  /* NAV */
  .nav {
    padding: 26px 0;
    border-bottom: 1px solid var(--charcoal-mid);
  }
  .nav .wrap { display: flex; justify-content: space-between; align-items: center; }
  .nav-name { font-family: 'Playfair Display', serif; font-weight: 600; font-size: 17px; }
  .nav-name em { font-style: normal; color: var(--gold); }
  .nav-tag { font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--warm-white-muted); }

  /* HERO */
  .hero {
    padding: 90px 0 56px;
    background-image: repeating-linear-gradient(0deg, rgba(201,165,81,0.04) 0px, rgba(201,165,81,0.04) 1px, transparent 1px, transparent 40px),
                       repeating-linear-gradient(90deg, rgba(201,165,81,0.04) 0px, rgba(201,165,81,0.04) 1px, transparent 1px, transparent 40px);
  }
  .eyebrow {
    display: inline-block;
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--gold);
    font-weight: 600;
    margin-bottom: 20px;
    padding-bottom: 7px;
    border-bottom: 2px solid var(--gold-dim);
  }
  .hero h1 { font-size: clamp(32px, 5vw, 48px); letter-spacing: -0.01em; margin-bottom: 22px; }
  .hero .sub { font-size: 17px; color: var(--warm-white-dim); max-width: 540px; margin-bottom: 36px; }

  .hero-meta {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
    padding-top: 26px;
    border-top: 1px solid var(--charcoal-mid);
  }
  .hero-meta div { display: flex; flex-direction: column; gap: 4px; }
  .hero-meta .label { font-size: 10px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--warm-white-muted); }
  .hero-meta .value { font-size: 14px; font-weight: 600; color: var(--warm-white); }
  .hero-meta .value.stat { color: var(--gold); font-size: 20px; font-family: 'Playfair Display', serif; }

  /* SECTION SCAFFOLDING */
  section.block { padding: 64px 0; border-top: 1px solid var(--charcoal-mid); }
  .kicker { font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--gold); font-weight: 600; margin-bottom: 14px; }
  .block h2 { font-size: clamp(24px, 3.4vw, 32px); margin-bottom: 26px; max-width: 540px; }
  .block p { font-size: 16px; color: var(--warm-white-dim); margin-bottom: 18px; max-width: 620px; }

  .pull-line {
    font-family: 'Playfair Display', serif;
    font-style: italic;
    font-size: 21px;
    color: var(--warm-white);
    border-left: 3px solid var(--gold);
    padding: 4px 0 4px 20px;
    margin: 28px 0;
    max-width: 540px;
  }

  /* SYSTEM LIST */
  .system-list { display: flex; flex-direction: column; margin-top: 32px; }
  .system-item { display: grid; grid-template-columns: 40px 1fr; gap: 18px; padding: 24px 0; border-top: 1px solid var(--charcoal-mid); }
  .system-item:last-child { border-bottom: 1px solid var(--charcoal-mid); }
  .system-mark { font-family: 'Playfair Display', serif; font-style: italic; color: var(--gold); font-size: 19px; padding-top: 2px; }
  .system-item h3 { font-size: 18px; margin-bottom: 7px; font-weight: 600; }
  .system-item p { font-size: 15px; color: var(--warm-white-dim); margin-bottom: 0; }

  /* HEADLINE STAT */
  .stat-block {
    background: var(--charcoal-light);
    border: 1px solid var(--gold-dim);
    border-radius: 4px;
    padding: 36px 34px;
    margin-top: 8px;
    margin-bottom: 40px;
    text-align: center;
  }
  .stat-number {
    font-family: 'Playfair Display', serif;
    font-size: clamp(48px, 8vw, 72px);
    color: var(--gold);
    line-height: 1;
    margin-bottom: 10px;
  }
  .stat-caption { font-size: 15px; color: var(--warm-white-dim); max-width: 460px; margin: 0 auto; }

  /* OUTCOMES */
  .outcomes { display: grid; grid-template-columns: 1fr; gap: 1px; background: var(--charcoal-mid); border: 1px solid var(--charcoal-mid); }
  .outcome { background: var(--charcoal); padding: 26px 28px; display: grid; grid-template-columns: 1fr 3fr; gap: 22px; align-items: start; }
  .outcome-tag { font-size: 10px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--gold); font-weight: 600; padding-top: 3px; }
  .outcome-text { font-size: 16px; color: var(--warm-white-dim); }
  @media (max-width: 560px) { .outcome { grid-template-columns: 1fr; gap: 6px; } }

  /* TESTIMONIAL */
  .testimonial-block { background: var(--charcoal-light); padding: 80px 0; }
  .testimonial-block .kicker { color: var(--gold); }

  .big-quote {
    font-family: 'Playfair Display', serif;
    font-weight: 500;
    font-style: italic;
    font-size: clamp(22px, 3.4vw, 30px);
    line-height: 1.42;
    color: var(--warm-white);
    margin: 26px 0 36px;
  }
  .big-quote::before, .big-quote::after { content: '"'; color: var(--gold); }

  .quote-attribution { display: flex; align-items: center; gap: 14px; margin-bottom: 50px; }
  .quote-avatar {
    width: 64px; height: 64px; border-radius: 50%;
    object-fit: cover;
    border: 2px solid var(--gold);
    flex-shrink: 0;
  }
  .quote-attribution .name { font-weight: 600; font-size: 14px; color: var(--warm-white); }
  .quote-attribution .role { font-size: 12px; color: var(--warm-white-muted); }

  .secondary-quotes { display: grid; gap: 26px; padding-top: 40px; border-top: 1px solid var(--charcoal-mid); }
  .secondary-quote { font-size: 15px; color: var(--warm-white-dim); line-height: 1.7; }
  .secondary-quote .quote-mark { color: var(--gold); font-size: 19px; }

  /* CTA */
  .cta-block { padding: 88px 0 100px; text-align: center; }
  .cta-block h2 { font-size: clamp(26px, 3.8vw, 36px); margin: 0 auto 16px; max-width: 500px; }
  .cta-block p { font-size: 16px; color: var(--warm-white-dim); max-width: 460px; margin: 0 auto 36px; }
  .cta-buttons { display: flex; gap: 14px; justify-content: center; flex-wrap: wrap; }
  .btn { display: inline-block; padding: 15px 30px; font-size: 14px; font-weight: 600; text-decoration: none; border-radius: 3px; transition: transform 0.15s ease; }
  .btn-primary { background: var(--gold); color: var(--charcoal); }
  .btn-primary:hover { transform: translateY(-2px); }
  .btn-secondary { background: transparent; color: var(--warm-white); border: 1.5px solid var(--warm-white-muted); }
  .btn-secondary:hover { transform: translateY(-2px); border-color: var(--gold); }

  footer { padding: 36px 0; border-top: 1px solid var(--charcoal-mid); text-align: center; }
  footer p { font-size: 12px; color: var(--warm-white-muted); }

  @media (max-width: 600px) {
    .hero { padding: 60px 0 44px; }
    section.block { padding: 48px 0; }
    .hero-meta { grid-template-columns: 1fr 1fr; }
  }
</style>
